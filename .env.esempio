# Copia questo file come .env nella cartella dati (dati/.env, oppure ~/.elbandito/.env se usi il plugin).
# Tutto è facoltativo: senza chiavi l'estrazione e la ricerca le fa Claude Code.

# Estrazione automatica (gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ripiego dell'estrazione, ricerca settimanale via API, "cerca a fondo" dalla dashboard
ANTHROPIC_API_KEY=

# Foglio Google invece dei CSV locali (vedi README)
ELBANDITO_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Facoltativi
SEARXNG_URL=
# Un contatto (sito o pagina) da mettere nello user-agent del collettore
ELBANDITO_CONTATTO=
